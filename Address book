
#!/bin/bash

FILE="addressbook.txt"

# Create Address Book
createAddressBook()
{
    if [ -e "$FILE" ]; then
        echo "Address book already exists."
    else
        touch "$FILE"
        echo "Address book created."
    fi
}

# View Address Book
viewAddressBook()
{
    if [ ! -s "$FILE" ]; then
        echo "Address book is empty or does not exist."
    else
        echo "----- Address Book -----"
        cat "$FILE"
    fi
}

# Insert Record
insertRecord()
{
    echo "Enter record (LastName,FirstName,Email,Phone):"
    read record
    echo "$record" >> "$FILE"
    echo "Record inserted."
}

# Delete Record
deleteRecord()
{
    echo "Enter name or email to search:"
    read search

    grep -in "$search" "$FILE"

    echo "Enter line number to delete:"
    read line

    sed -i "${line}d" "$FILE"
    echo "Record deleted."
}

# Modify Record
modifyRecord()
{
    echo "Enter name or email to search:"
    read search

    grep -in "$search" "$FILE"

    echo "Enter line number to modify:"
    read line

    echo "Enter new record:"
    read newRecord

    sed -i "${line}s|.*|$newRecord|" "$FILE"
    echo "Record modified."
}

# Exit
exitProgram()
{
    echo "Exiting... Goodbye!"
    exit 0
}

# Menu
while true
do
    echo "===== Address Book Menu ====="
    echo "1. Create Address Book"
    echo "2. View Address Book"
    echo "3. Insert a Record"
    echo "4. Delete a Record"
    echo "5. Modify a Record"
    echo "6. Exit"

    echo "Enter your choice:"
    read choice

    case $choice in
        1) createAddressBook ;;
        2) viewAddressBook ;;
        3) insertRecord ;;
        4) deleteRecord ;;
        5) modifyRecord ;;
        6) exitProgram ;;
        *) echo "Invalid choice. Select 1-6." ;;
    esac
done
